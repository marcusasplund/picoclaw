{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "perfectionist/sort-interfaces": [
      "error"
    ],
    "perfectionist/sort-objects": [
      "error",
      {
        "type": "alphabetical"
      }
    ]
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**"
  ],
  "jsPlugins": [
    "eslint-plugin-perfectionist"
  ],
  "settings": {
    "perfectionist": {
      "partitionByComment": true,
      "type": "line-length"
    }
  }
}
